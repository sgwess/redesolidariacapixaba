# ==============================================================================
# VARIÁVEIS DE AMBIENTE - REDE SOLIDÁRIA CSC (VERCEL)
# ==============================================================================

# 1. Chave Mestre de Administração (Senha de acesso ao painel de cadastro e edição)
# Mude para uma senha forte exclusiva da coordenação (ex: CSC_Admin_Forte_2026!#)
CSC_ADMIN_KEY="CSC_REDE_SOLIDARIA_2026"

# 2. Segredo Criptográfico para Assinatura de Tokens de Sessão (HMAC-SHA256)
# Pode ser qualquer sequência aleatória longa e secreta
JWT_SECRET="CSC_SECRET_HASH_KEY_9921_SOLIDARIEDADE"

# 3. Integração com Google Sheets (Opcional - caso queira salvar em planilha)
# Cole aqui a URL gerada pelo Google Apps Script (termina em /exec)
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/SEU_SCRIPT_ID/exec"

# 4. Token Secreto de Comunicação Servidor-a-Servidor com o Google Apps Script
CSC_API_SECRET="CSC_MILITANCIA_SEGURA_2026"
